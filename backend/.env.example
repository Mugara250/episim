# --- Database ---
DATABASE_URL=postgresql+asyncpg://episim:episim@postgres:5432/episim

# --- Redis (Celery broker + read-through cache) ---
REDIS_URL=redis://redis:6379/0

# --- Object storage (MinIO locally, real S3 in production with no code change) ---
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=episim_minio
MINIO_ROOT_PASSWORD=episim_minio_secret
MINIO_BUCKET=episim

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string-in-every-environment
JWT_LIFETIME_SECONDS=3600

# --- SMTP (dev: routed to Mailhog, a log-only mail catcher, no real email is sent) ---
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@episim.local

# --- App ---
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
