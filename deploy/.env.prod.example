# Copy to ../.env.prod (repo root) and fill in. Never commit the real file.
# Generate secrets with: openssl rand -hex 32

# --- Domains (both DNS A records must point at this server) ---
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
FRONTEND_URL=https://app.example.com
ENVIRONMENT=production

# --- Database (POSTGRES_* initialise the container; DATABASE_URL must match) ---
POSTGRES_USER=episim
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=episim
DATABASE_URL=postgresql+asyncpg://episim:CHANGE_ME@postgres:5432/episim

REDIS_URL=redis://redis:6379/0

# --- Object storage (MINIO_ROOT_* initialise MinIO and are the backend's S3 keys) ---
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=episim
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_BUCKET=episim
MINIO_REGION=us-east-1

# --- Auth (at least 32 random characters; the app refuses to start otherwise) ---
JWT_SECRET=CHANGE_ME
JWT_LIFETIME_SECONDS=3600

# --- SMTP: a real provider (Resend, Brevo, Mailgun, SES, Gmail app password...) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=noreply@example.com
